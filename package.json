{
  "name": "farm-pilot-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/gen-notices.mjs && tsc -p tsconfig.json && npm --prefix web run build",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "sim": "node dist/sim/simulator.js",
    "dev": "tsx watch src/index.ts",
    "seed:bench": "node dist/scripts/seed-bench.js",
    "test": "node --import tsx --import ./test/isolate.ts --test --test-force-exit test/*.test.ts",
    "licence": "node --import tsx tools/licence-issue/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "aedes": "^1.2.0",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "mqtt": "^5.16.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  }
}
