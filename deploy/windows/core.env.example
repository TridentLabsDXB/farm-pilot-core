# Farm-Pilot CORE settings (optional). Copy this file to C:\FarmPilot-Core\core.env and remove the # in front of what you want to change.
# One KEY=VALUE per line, no spaces around =. start-core.cmd reads it at every start; restart CORE after a change.

# Port of the web page. Default 4100.
#PORT=4100

# Which network interfaces listen. start-core.cmd sets 0.0.0.0 (every interface, so a phone on the tablet's hotspot can connect) when this line is absent.
# 127.0.0.1 = this tablet only.
#HOST_BIND_IP=127.0.0.1

# Choose the first admin password yourself instead of a generated one (only used when the first admin user is created).
#CORE_ADMIN_PASSWORD=

# Move the data (database, backups, licence) to another LOCAL disk folder. Never a USB stick or network drive.
#DATA_DIR=D:\FarmPilot-Core\data

# Gateway link used before the RS-485 Ports page is set up (normally leave it off and use Settings > RS-485 Ports).
#GW_TRANSPORT=off

# Keep history even on the FREE licence (days). Normally the licence decides, leave unset.
#RETENTION_DAYS=

# Log every Modbus request and answer on a serial port as hex bytes (INFO lines "modbus TX COM11 ..." / "modbus RX COM11 ..."). Only for diagnosis: it is chatty. 1 = on.
#LOG_MODBUS=1
