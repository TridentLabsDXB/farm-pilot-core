# DEV / TEST BENCH ONLY. XZ-DS-MUS2 gateway simulator (Modbus TCP 5020, RTU-over-TCP 5021, control HTTP 5030, all loopback).
# Installed by deploy/install-sim.sh, never by deploy.sh, never part of the box image. Independent of farmpilot-core-sim.service (the MQTT pump/sensor simulator).
[Unit]
Description=Farm-Pilot CORE gateway simulator (dev only)
After=network.target

[Service]
User=fpcore
Group=fpcore
WorkingDirectory=/opt/farmpilot-core
EnvironmentFile=-/etc/farmpilot-gateway-sim.env
ExecStart=/opt/farmpilot-core/node/bin/node /opt/farmpilot-core/dist/tools/gateway-sim/main.js
Restart=always
RestartSec=3
MemoryMax=192M
CPUWeight=10
IOWeight=10
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
