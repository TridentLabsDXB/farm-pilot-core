[Unit]
Description=Farm-Pilot CORE runtime (test bench core.farm-pilot.com)
After=network-online.target
Wants=network-online.target

[Service]
User=fpcore
Group=fpcore
WorkingDirectory=/opt/farmpilot-core
EnvironmentFile=-/etc/farmpilot-core.env
Environment=NODE_ENV=production
ExecStart=/opt/farmpilot-core/node/bin/node --max-old-space-size=512 /opt/farmpilot-core/dist/index.js
Restart=always
RestartSec=3
TimeoutStopSec=20
# Emulate the appliance AND stay a polite neighbour of production on this shared 2 vCPU / 7.8 GB host:
# MemoryHigh throttles first, MemoryMax kills; low weights mean production wins any contention.
MemoryHigh=1500M
MemoryMax=2G
CPUQuota=200%
CPUWeight=20
IOWeight=20
TasksMax=256
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/farmpilot-core
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
