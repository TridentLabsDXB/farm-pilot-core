# /etc/farmpilot-core.env  (mode 640 root:fpcore). Never committed.
HOST_BIND_IP=10.0.0.3
PORT=4100
MQTT_PORT=1884
# auto = Secure cookie only when the request arrived over HTTPS (NPM). Use false on the box's plain-HTTP hotspot, true to force.
COOKIE_SECURE=auto
# Milestone 2 gateway (XZ-DS-MUS2). Off unless GW_TRANSPORT is set. Bench: the simulator (Modbus TCP). Box: rtu-serial on the RS485 port.
#GW_TRANSPORT=tcp
#GW_HOST=127.0.0.1
#GW_PORT=5020
#GW_SERIAL_PATH=/dev/ttyUSB0
#GW_BAUD=9600
