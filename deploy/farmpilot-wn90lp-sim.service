# DEV / TEST BENCH ONLY. WN90LP weather-station simulator (Modbus TCP 5040, RTU-over-TCP 5041, control HTTP 5050, all loopback; register layout NOT verified).
# Installed by deploy/install-gateway-sim.sh, never by deploy.sh, never part of the box image. Independent of farmpilot-core-sim.service and farmpilot-gateway-sim.service.
[Unit]
Description=Farm-Pilot CORE weather-station simulator (dev only)
After=network.target

[Service]
User=fpcore
Group=fpcore
WorkingDirectory=/opt/farmpilot-core
ExecStart=/opt/farmpilot-core/node/bin/node /opt/farmpilot-core/dist/tools/wn90lp-sim/main.js
Restart=always
RestartSec=3
MemoryMax=192M
CPUWeight=10
IOWeight=10
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
